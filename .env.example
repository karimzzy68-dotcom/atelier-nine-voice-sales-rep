# Get a key at https://elevenlabs.io/app/settings/api-keys (needs Agents / Conversational AI access)
ELEVENLABS_API_KEY=
# Filled in automatically by: npm run setup-agent
ELEVENLABS_AGENT_ID=
# Optional: pick a voice from `npm run voices` (default is Sarah, warm and natural)
VOICE_ID=
# Optional overrides
TTS_MODEL=
LLM=
PORT=5173
